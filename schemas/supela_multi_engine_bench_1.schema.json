{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supela.omega-zero.local/schemas/supela_multi_engine_bench_1.schema.json",
  "title": "Banc Multi-Moteurs Supela (supela-multi-engine-bench/1)",
  "description": "Schéma Draft 2020-12 validant le banc multi-moteurs non-votant, les 10 champs minimaux par moteur et la détection symétrique SUPELA_EN_DÉFAUT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objet",
    "vote_interdit",
    "convergence_n_est_pas_preuve",
    "outcome",
    "supela_en_defaut",
    "verdict_banc",
    "statut_verite",
    "promotion_autorisee",
    "ratification_humaine_requise",
    "preuves_verifiees",
    "referentiels",
    "contradictions_consolidees",
    "moteurs",
    "report_sha256"
  ],
  "properties": {
    "schema": { "const": "supela-multi-engine-bench/1" },
    "objet": { "type": "string", "minLength": 1 },
    "vote_interdit": { "const": true },
    "convergence_n_est_pas_preuve": { "const": true },
    "outcome": {
      "type": "string",
      "enum": ["CONVERGENCE", "DIVERGENCE", "INDÉTERMINÉ"]
    },
    "supela_en_defaut": { "type": "boolean" },
    "verdict_banc": {
      "type": "string",
      "enum": [
        "CONVERGENCE_SANS_PREUVE",
        "CONVERGENCE_ETAYEE_A_RATIFIER",
        "DIVERGENCE_CONSERVEE",
        "INDETERMINE_OUVERT",
        "SUPELA_EN_DEFAUT"
      ]
    },
    "statut_verite": {
      "type": "string",
      "enum": ["NON_ÉTABLI", "PARTIELLEMENT_ÉTABLI", "ÉTABLI_DANS_LE_PÉRIMÈTRE", "CONTRADICTOIRE", "INDÉTERMINÉ"]
    },
    "promotion_autorisee": { "type": "boolean" },
    "ratification_humaine_requise": { "const": true },
    "preuves_verifiees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["moteur", "referentiel", "preuve_fournie"],
        "properties": {
          "moteur": { "type": "string", "minLength": 1 },
          "referentiel": { "type": "string", "minLength": 1 },
          "preuve_fournie": { "type": "string", "minLength": 1 }
        }
      }
    },
    "referentiels": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "contradictions_consolidees": {
      "type": "array",
      "items": { "type": "string" }
    },
    "moteurs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objet",
          "moteur",
          "version",
          "referentiel",
          "premisses",
          "methode",
          "resultat",
          "preuve_fournie",
          "preuve_verifiee",
          "contradictions",
          "statut"
        ],
        "properties": {
          "objet": { "type": "string", "minLength": 1 },
          "moteur": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "referentiel": { "type": "string", "minLength": 1 },
          "premisses": {
            "type": "array",
            "items": { "type": "string" }
          },
          "methode": { "type": "string", "minLength": 1 },
          "resultat": {
            "type": "string",
            "enum": ["VRAI", "FAUX", "INDÉTERMINÉ", "ERREUR"]
          },
          "preuve_fournie": { "type": "string" },
          "preuve_verifiee": { "type": "boolean" },
          "contradictions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "statut": {
            "type": "string",
            "enum": ["CANDIDAT", "PROUVE", "REFUTE", "INDETERMINE", "EN_DEFAUT"]
          },
          "est_supela": { "type": "boolean" },
          "auto_promotion_tentee": { "type": "boolean" }
        }
      }
    },
    "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "supela_en_defaut": { "const": true } } },
      "then": {
        "properties": {
          "verdict_banc": { "const": "SUPELA_EN_DEFAUT" },
          "promotion_autorisee": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "preuves_verifiees": { "maxItems": 0 } } },
      "then": { "properties": { "promotion_autorisee": { "const": false } } }
    }
  ]
}
