{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supela.omega-zero.local/schemas/supela_contradictions_1.schema.json",
  "title": "Registre des Contradictions & Échecs Conservés · Supela Ω-ZERO (supela-contradictions/1)",
  "description": "Schéma JSON Draft 2020-12 garantissant l'invariant de non-effacement : une contradiction ou un échec antérieur (ex. essai adversarial T11) n'est jamais supprimé même lorsqu'un run ultérieur devient PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "date",
    "principe_non_effacement",
    "effacement_interdit",
    "contradictions"
  ],
  "properties": {
    "schema": { "const": "supela-contradictions/1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "principe_non_effacement": { "type": "string", "minLength": 10 },
    "effacement_interdit": { "const": true },
    "contradictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "titre",
          "objet_concerne",
          "statut_contradiction",
          "etat_4d",
          "constat_fail_historique",
          "etat_ulterieur",
          "justification_conservation",
          "invariants_impactes",
          "conditions_reouverture",
          "source_provenance"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^CONTR-[A-Z0-9_-]+$" },
          "titre": { "type": "string", "minLength": 4 },
          "objet_concerne": { "type": "string", "minLength": 2 },
          "statut_contradiction": {
            "type": "string",
            "enum": [
              "CONSERVEE_OUVERTE",
              "CONSERVEE_NON_ACQUISE",
              "HISTORIQUE_CORRIGEE_CONSERVEE",
              "INCONNUE_SOURCE_INCOMPLETE"
            ]
          },
          "etat_4d": {
            "type": "string",
            "enum": ["ACTIF", "LATENT", "RÉOUVERT"]
          },
          "constat_fail_historique": { "type": "string", "minLength": 5 },
          "etat_ulterieur": { "type": "string", "minLength": 5 },
          "justification_conservation": { "type": "string", "minLength": 5 },
          "invariants_impactes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "conditions_reouverture": { "type": "string", "minLength": 5 },
          "source_provenance": { "type": "string", "minLength": 3 },
          "url_source": { "type": "string" }
        }
      }
    }
  }
}
