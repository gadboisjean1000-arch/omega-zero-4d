{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supela.omega-zero.local/schemas/projection_pi0.schema.json",
  "title": "Opérateur de projection Π₀ · Supela Ω-ZERO",
  "description": "Schéma exécutable Draft 2020-12 formalisant l'opérateur de projection Π₀(S_t) = {I, P, M, A, H}, ses propriétés algébriques et ses assertions vérifiables.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "title",
    "formula",
    "local_formula",
    "distinction_PiI_vs_Pi0",
    "components",
    "core_invariants",
    "algebraic_properties",
    "assertions_executables"
  ],
  "properties": {
    "schema": {
      "const": "projection-Pi0/1"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["PROPOSE", "VALIDE_SCHEMA", "ADMISSIBLE_REVUE_HUMAINE", "VERROUILLE"]
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "formula": {
      "type": "string",
      "const": "Π₀(S_t) = {I, P, M, A, H}"
    },
    "local_formula": {
      "type": "string",
      "minLength": 10
    },
    "distinction_PiI_vs_Pi0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Pi_I", "Pi_0", "relation"],
      "properties": {
        "Pi_I": { "type": "string", "minLength": 10 },
        "Pi_0": { "type": "string", "minLength": 10 },
        "relation": { "type": "string", "minLength": 10 }
      }
    },
    "components": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "name", "role", "retention_rule", "drop_rule"],
        "properties": {
          "symbol": { "type": "string", "enum": ["I", "P", "M", "A", "H"] },
          "name": { "type": "string", "minLength": 2 },
          "role": { "type": "string", "minLength": 5 },
          "retention_rule": { "type": "string", "minLength": 5 },
          "drop_rule": { "type": "string", "minLength": 5 }
        }
      }
    },
    "core_invariants": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "formal_statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^I([1-5]|_M)$" },
          "label": { "type": "string", "minLength": 3 },
          "formal_statement": { "type": "string", "minLength": 5 }
        }
      }
    },
    "algebraic_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotence",
        "non_empty_fail_closed",
        "authority_bounding",
        "non_amnesic_local",
        "refutation_preservation"
      ],
      "properties": {
        "idempotence": { "type": "string", "minLength": 5 },
        "non_empty_fail_closed": { "type": "string", "minLength": 5 },
        "authority_bounding": { "type": "string", "minLength": 5 },
        "non_amnesic_local": { "type": "string", "minLength": 5 },
        "refutation_preservation": { "type": "string", "minLength": 5 }
      }
    },
    "assertions_executables": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "formal_expression", "verification_method", "failure_mode"],
        "properties": {
          "id": { "type": "string", "pattern": "^PI0-ASSERT-[0-9]{2}$" },
          "formal_expression": { "type": "string", "minLength": 5 },
          "verification_method": { "type": "string", "minLength": 5 },
          "failure_mode": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}
