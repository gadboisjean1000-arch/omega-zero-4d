{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supela.omega-zero.local/schemas/manque_statut.schema.json",
  "title": "Statuts et Machine à États du Manque · Supela Ω-ZERO",
  "description": "Schéma exécutable Draft 2020-12 formalisant les 7 statuts canoniques du Manque, les règles déontologiques M1–M5 et la matrice des transitions autorisées/interdites.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "title",
    "definition",
    "invariant_IM",
    "object_structure",
    "statuts",
    "deontological_rules",
    "state_machine"
  ],
  "properties": {
    "schema": { "const": "manque-statut/1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": {
      "type": "string",
      "enum": ["PROPOSE", "VALIDE_SCHEMA", "ADMISSIBLE_REVUE_HUMAINE", "VERROUILLE"]
    },
    "title": { "type": "string", "minLength": 5 },
    "definition": { "type": "string", "minLength": 10 },
    "invariant_IM": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal", "normative_statement"],
      "properties": {
        "formal": { "type": "string", "minLength": 5 },
        "normative_statement": { "type": "string", "minLength": 10 }
      }
    },
    "object_structure": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "string",
        "enum": [
          "id",
          "question",
          "contexte",
          "origine",
          "dépendances",
          "autorité",
          "tentatives",
          "temps",
          "statut"
        ]
      },
      "uniqueItems": true
    },
    "statuts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "category", "description", "preserves_history", "preserves_in_Pi0"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "OUVERT",
              "SOUS_EXPLORATION",
              "PARTIELLEMENT_RÉDUIT",
              "RÉSOLU",
              "RÉFUTÉ_COMME_PROBLÈME",
              "REQUALIFIÉ",
              "INACCESSIBLE_DANS_LE_PÉRIMÈTRE"
            ]
          },
          "category": {
            "type": "string",
            "enum": ["ACTIF", "CLOTURE_CONDITIONNELLE", "REOUVRABLE"]
          },
          "description": { "type": "string", "minLength": 10 },
          "preserves_history": { "const": true },
          "preserves_in_Pi0": { "type": "boolean" }
        }
      }
    },
    "deontological_rules": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "formal", "description", "violation_effect"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[1-5]$" },
          "label": { "type": "string", "minLength": 3 },
          "formal": { "type": "string", "minLength": 3 },
          "description": { "type": "string", "minLength": 5 },
          "violation_effect": { "type": "string", "minLength": 5 }
        }
      }
    },
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_status", "reopenable_statuses", "allowed_transitions", "forbidden_transitions"],
      "properties": {
        "initial_status": { "const": "OUVERT" },
        "reopenable_statuses": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "enum": ["RÉSOLU", "RÉFUTÉ_COMME_PROBLÈME", "INACCESSIBLE_DANS_LE_PÉRIMÈTRE"]
          },
          "uniqueItems": true
        },
        "allowed_transitions": {
          "type": "array",
          "minItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "guard_id", "preconditions", "trace_required"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "guard_id": { "type": "string", "pattern": "^TR-[0-9]{2}$" },
              "preconditions": { "type": "string", "minLength": 5 },
              "trace_required": { "const": true }
            }
          }
        },
        "forbidden_transitions": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "violated_rule", "reason"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "violated_rule": { "type": "string", "minLength": 2 },
              "reason": { "type": "string", "minLength": 5 }
            }
          }
        }
      }
    }
  }
}
